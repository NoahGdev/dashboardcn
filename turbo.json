{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "registry:build": {
      "inputs": ["registry.json", "registry/**", "components.json"],
      "outputs": ["public/r/**"]
    },
    "build": {
      "dependsOn": ["^build", "registry:build"],
      "env": ["NEXT_PUBLIC_BASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["registry:build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
